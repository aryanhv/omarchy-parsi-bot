# Required: Telegram Bot API settings
TELEGRAM_BOT_TOKEN=123456789:your-bot-token
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_TOPIC_ID=123

# Optional: Gemini API key for Persian translation (falls back to English if unset)
GEMINI_API_KEY=your-gemini-api-key

# Optional: Override the default Omarchy RSS feed URL
# RSS_URL=https://omarchy.org/news/rss.xml
